+    # Trigger phrases for parameter extraction, longest-first so multi-word
+    # triggers (e.g. "remind me to") are consumed whole instead of leaving
+    # leftover filler words ("me to ...") in the extracted text.
+    _REMINDER_TRIGGERS = [
+        "set a reminder for", "set a reminder to", "set reminder for",
+        "remind me to", "remind me about", "remind me", "remember to",
+        "reminder", "remember", "remind",
+    ]
+    _SEARCH_TRIGGERS = [
+        "search the web for", "look up", "look for", "search for",
+        "find information about", "find information on", "search",
+        "find", "lookup",
+    ]
+
+    def _extract_after_trigger(self, text: str, triggers: List[str]) -> Optional[str]:
+        """Find the longest matching trigger phrase and return the text after it, trimmed."""
+        text_lower = text.lower()
+        for trigger in sorted(triggers, key=len, reverse=True):
+            match = re.search(rf"\b{re.escape(trigger)}\b\s*", text_lower)
+            if match:
+                remainder = text[match.end():].strip()
+                return remainder or None
+        return None
+

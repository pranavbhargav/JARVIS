+    def test_search_query_strips_filler_words(self):
+        """'look up X' / 'search for X' should not leak 'up'/'for' into the query"""
+        params = self.recognizer.extract_parameters("look up python tutorials", "search")
+        self.assertEqual(params["query"], "python tutorials")
+
+        params = self.recognizer.extract_parameters("search for machine learning", "search")
+        self.assertEqual(params["query"], "machine learning")
+
+    def test_reminder_text_strips_filler_words(self):
+        """'remind me to X' should not leak 'me to' into the reminder text"""
+        params = self.recognizer.extract_parameters("remind me to buy groceries", "reminder")
+        self.assertEqual(params["reminder_text"], "buy groceries")
     
